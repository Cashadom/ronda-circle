rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }


    // ─────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────

    match /users/{userId} {

      // Les membres connectés peuvent consulter les profils
      allow read: if isSignedIn();

      // Chacun peut créer / modifier / supprimer son propre profil
      allow create, update, delete: if isSignedIn()
        && uid() == userId;
    }


    // ─────────────────────────────────────────────────────────────────────
    // CONNECTIONS
    // ─────────────────────────────────────────────────────────────────────

    match /connections/{connectionId} {

      // Nécessaire pour charger les états connect / pending / message
      allow read: if isSignedIn();


      // Création d'une demande de connexion
      allow create: if isSignedIn()

        && request.resource.data.participants is list

        && request.resource.data.participants.size() == 2

        && uid() in request.resource.data.participants

        && request.resource.data.requestedBy == uid()

        && request.resource.data.status == 'pending';


      // Modification d'une connexion existante
      // uniquement par l'un des deux participants
      allow update: if isSignedIn()

        && resource.data.participants is list

        && uid() in resource.data.participants;


      // Annulation d'une demande en attente
      allow delete: if isSignedIn()

        && resource.data.participants is list

        && uid() in resource.data.participants

        && resource.data.status == 'pending';


      // ───────────────────────────────────────────────────────────────────
      // PRIVATE MESSAGES
      // connections/{connectionId}/messages/{messageId}
      // ───────────────────────────────────────────────────────────────────

      match /messages/{messageId} {

        // Messages visibles uniquement après connexion acceptée
        allow read: if isSignedIn()

          && get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.status == 'connected'

          && uid() in get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.participants;


        // Envoi uniquement entre personnes connectées
        allow create: if isSignedIn()

          && get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.status == 'connected'

          && uid() in get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.participants

          && request.resource.data.author_id == uid()

          && request.resource.data.text is string

          && request.resource.data.text.size() > 0

          && request.resource.data.text.size() <= 1000;


        allow update, delete: if false;
      }
    }


    // ─────────────────────────────────────────────────────────────────────
    // CIRCLES
    // Ancien système conservé pour ne pas casser l'existant
    // ─────────────────────────────────────────────────────────────────────

    match /circles/{circleId} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update: if isSignedIn();

      allow delete: if false;


      // Membres des anciens circles
      match /members/{memberId} {

        allow read: if true;

        allow create, update: if isSignedIn()
          && uid() == memberId;

        allow delete: if isSignedIn()
          && uid() == memberId;
      }


      // Messages publics des anciens circles
      match /messages/{messageId} {

        allow read: if true;

        allow create: if isSignedIn()

          && request.resource.data.text is string

          && request.resource.data.text.size() > 0

          && request.resource.data.text.size() <= 280;

        allow update, delete: if false;
      }
    }


    // ─────────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    // Tout ce qui n'est pas explicitement autorisé ci-dessus est bloqué
    // ─────────────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}