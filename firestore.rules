rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }


    // ─────────────────────────────────────────────────────────────────────
    // USERS
    // Les profils Ronda restent visibles publiquement.
    // Un utilisateur ne peut modifier que son propre profil.
    // ─────────────────────────────────────────────────────────────────────

    match /users/{userId} {

      allow read: if true;

      allow create, update, delete: if isSignedIn()
        && uid() == userId;


      // ───────────────────────────────────────────────────────────────────
      // USER CIRCLES
      // users/{userId}/circles/{circleId}
      //
      // Nécessaire lors de la création / inscription / sortie d'un Circle.
      // Firestore n'hérite pas automatiquement des règles du parent.
      // ───────────────────────────────────────────────────────────────────

      match /circles/{circleId} {

        allow read: if isSignedIn()
          && uid() == userId;

        allow create, update, delete: if isSignedIn()
          && uid() == userId;
      }
    }


    // ─────────────────────────────────────────────────────────────────────
    // CONNECTIONS
    // Les connexions restent privées entre les deux participants.
    // ─────────────────────────────────────────────────────────────────────

    match /connections/{connectionId} {

      allow read: if isSignedIn()
        && resource.data.participants is list
        && uid() in resource.data.participants;


      // Création d'une demande de connexion
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && uid() in request.resource.data.participants
        && request.resource.data.requestedBy == uid()
        && request.resource.data.status == 'pending';


      // Modification uniquement par l'un des participants
      allow update: if isSignedIn()
        && resource.data.participants is list
        && uid() in resource.data.participants;


      // Suppression uniquement d'une demande encore en attente
      allow delete: if isSignedIn()
        && resource.data.participants is list
        && uid() in resource.data.participants
        && resource.data.status == 'pending';


      // ───────────────────────────────────────────────────────────────────
      // PRIVATE MESSAGES
      // connections/{connectionId}/messages/{messageId}
      // ───────────────────────────────────────────────────────────────────

      match /messages/{messageId} {

        // Lecture uniquement par les participants
        allow read: if isSignedIn()
          && get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.participants is list
          && uid() in get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.participants;


        // Envoi uniquement après connexion acceptée
        allow create: if isSignedIn()
          && get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.status == 'connected'
          && uid() in get(
            /databases/$(database)/documents/connections/$(connectionId)
          ).data.participants
          && request.resource.data.author_id == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;


        allow update, delete: if false;
      }
    }


    // ─────────────────────────────────────────────────────────────────────
    // PUBLIC AGGREGATED DASHBOARD
    // Utilisé notamment par /dashboard et les statistiques publiques.
    // ─────────────────────────────────────────────────────────────────────

    match /public_stats/{documentId} {

      allow read: if true;

      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────
    // CIRCLES
    // ─────────────────────────────────────────────────────────────────────

    match /circles/{circleId} {

      // Les Circles sont visibles publiquement
      allow read: if true;


      // Création uniquement par un utilisateur connecté
      // qui se déclare lui-même comme créateur.
      allow create: if isSignedIn()
        && request.resource.data.created_by == uid();


      // Nécessaire notamment pour members_count lors des Join / Leave
      allow update: if isSignedIn();


      // Pas de suppression directe actuellement
      allow delete: if false;


      // ───────────────────────────────────────────────────────────────────
      // CIRCLE MEMBERS
      // circles/{circleId}/members/{memberId}
      //
      // Les snapshots des membres sont publics afin que les visiteurs
      // puissent voir les membres d'un Circle sans être connectés.
      // ───────────────────────────────────────────────────────────────────

      match /members/{memberId} {

        allow read: if true;

        allow create, update: if isSignedIn()
          && uid() == memberId;

        allow delete: if isSignedIn()
          && uid() == memberId;
      }


      // ───────────────────────────────────────────────────────────────────
      // LEGACY CIRCLE MESSAGES
      // Conservé pour compatibilité avec l'ancien système.
      // ───────────────────────────────────────────────────────────────────

      match /messages/{messageId} {

        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 280;

        allow update, delete: if false;
      }


      // ───────────────────────────────────────────────────────────────────
      // LEGACY WEEKLY MOMENTS
      // ───────────────────────────────────────────────────────────────────

      match /weeklyMoments/{momentId} {

        allow read: if true;

        allow write: if isSignedIn();
      }
    }


    // ─────────────────────────────────────────────────────────────────────
    // EXISTING RONDA COLLECTIONS
    // Conservées pour ne rien casser dans l'application existante.
    // ─────────────────────────────────────────────────────────────────────

    match /events/{document=**} {

      allow read: if true;

      allow write: if isSignedIn();
    }


    match /jobs/{document=**} {

      allow read: if true;

      allow write: if isSignedIn();
    }


    match /meetup_participants/{document=**} {

      allow read: if true;

      allow write: if isSignedIn();
    }


    match /meetups/{document=**} {

      allow read: if true;

      allow write: if isSignedIn();
    }


    match /pending_events/{document=**} {

      allow read: if true;

      allow write: if isSignedIn();
    }


    match /ronda_users/{document=**} {

      allow read: if true;

      allow write: if isSignedIn();
    }


    // ─────────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    // Tout ce qui n'est pas explicitement autorisé reste bloqué.
    // ─────────────────────────────────────────────────────────────────────

    match /{document=**} {

      allow read, write: if false;
    }
  }
}